{
  "name": "inkforge-core",
  "version": "0.1.0",
  "private": true,
  "description": "Million-word AI novel writing workbench - deterministic core mechanisms",
  "type": "commonjs",
  "main": "./out/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.vue.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "pnpm typecheck && pnpm typecheck:vue && pnpm test",
    "smoke": "node scripts/smoke.cjs",
    "ui-audit": "node scripts/ui-audit.cjs",
    "ci": "pnpm gate && pnpm build && pnpm smoke && pnpm ui-audit",
    "dev": "node scripts/dev.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "node scripts/launch.cjs"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^37.10.3",
    "electron-vite": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.8",
    "vitest": "^3.2.0",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  }
}
